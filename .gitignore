# Python
# venv and data are symlinks on the PC; a trailing-slash pattern does not match a symlink
venv
venv/
__pycache__/
*.pyc
*.pyo
.Python

# Large data files
/data
data/*.json
data/*.csv
data/*.zst

# Job database and runtime state
jobs/
chess_bench.db
data/jobs.db

# Results: everything is committed except the raw evaluation files, which are over GitHub's
# 100 MB file limit. They are published xz-compressed on the GitHub release "data-2026-10-31"
# (README, "Results and raw data").
results/evaluations.jsonl
results/archive/
results/benchmark.db
results/finetuning_experiment/evaluations_base_rerun.jsonl
results/finetuning_experiment/evaluations_ft.jsonl
results/finetuning_experiment/evaluations_legal_ft.jsonl
results/finetuning_experiment/*.bak-*

# Fine-tuning runtime cache (Unsloth)
unsloth_compiled_cache/

# Logs
*.log

# Coverage
.coverage
.coveragerc

# Vendor JS (vendored, not authored)
dashboard/chart.umd.min.js
dashboard/tailwind.min.js

# OS
.DS_Store

# Plain-board run (specs/plain-board-prompts.md): raw records go on the data release
results/plain_board/evaluations.jsonl
