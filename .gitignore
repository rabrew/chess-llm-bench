# Python
# venv and data are symlinks on the PC; a trailing-slash pattern does not match a symlink
venv
venv/
__pycache__/
*.pyc
*.pyo
.Python

# Large data files
/data
data/*.json
data/*.csv
data/*.zst

# Job database and runtime state
jobs/
chess_bench.db
data/jobs.db

# Results (generated output — not committed, reproduced from evaluations.jsonl)
results/evaluations.jsonl
results/evaluations_retried.jsonl
results/plots/
results/logs/
results/archive/
results/benchmark.db
results/finetuning_experiment/

# Fine-tuning runtime cache (Unsloth)
unsloth_compiled_cache/

# Logs
*.log

# Coverage
.coverage
.coveragerc

# Vendor JS (vendored, not authored)
dashboard/chart.umd.min.js
dashboard/tailwind.min.js

# OS
.DS_Store

# T2-5 engine-strength evaluation caches (regenerable)
results/engine_strength/
# Plain-board run (specs/plain-board-prompts.md): only the metrics are tracked
results/plain_board/*
!results/plain_board/metrics/
